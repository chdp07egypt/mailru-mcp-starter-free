# SPDX-License-Identifier: MPL-2.0
# Examples only. Keep the real .env local and out of Git.
# Mail.ru requires an app-specific password, NOT the mailbox login password.
MAILRU_USER=your-mailbox@mail.ru
MAILRU_APP_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=your-google-account@example.com
# Optional additional pin, leave unset unless you know the verified Google sub.
# ALLOWED_GOOGLE_SUB=
# Render sets RENDER_EXTERNAL_HOSTNAME automatically.
# For a custom domain / local HTTPS tunnel, use the external HTTPS origin.
# PUBLIC_BASE_URL=https://your-service.example.com
